---
import { MapPin, Phone, Mail, Clock, Instagram, Facebook, Heart } from "lucide-react";
---

<footer class="bg-[#121213] text-white border-t border-white/10 mt-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      {/* Columna 1: Marca y Propósito */}
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/lapd-logo.webp"
            alt="Logo Las Asambleas de Dios del Perú"
            class="h-14 w-auto object-contain shrink-0"
          />
          <div class="flex flex-col text-left leading-tight">
            <span class="text-[0.55rem] font-semibold tracking-[0.12em] uppercase text-[#BA9A7D]">
              Iglesia Cristiana Evangélica Pentecostal
            </span>
            <span class="font-heading font-bold text-sm tracking-wide uppercase text-white">
              Las Asambleas de Dios del Perú
            </span>
            <span class="text-xs font-semibold text-white/80">
              Iglesia "Jesús Camino de Vida"
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-white/70 leading-relaxed font-body">
          Una casa abierta para ti. Una comunidad apasionada por proclamar el evangelio, restaurar familias y vivir la fe de forma real.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="size-9 rounded-lg bg-white/10 hover:bg-[#BA9A7D] flex items-center justify-center text-white transition-colors duration-200"
            aria-label="Facebook de JCV"
          >
            <Facebook className="size-4.5" />
          </a>
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="size-9 rounded-lg bg-white/10 hover:bg-[#BA9A7D] flex items-center justify-center text-white transition-colors duration-200"
            aria-label="Instagram de JCV"
          >
            <Instagram className="size-4.5" />
          </a>
        </div>
      </div>

      {/* Columna 2: Horarios */}
      <div class="space-y-3">
        <h4 class="font-heading font-bold text-sm uppercase tracking-wider text-[#BA9A7D] flex items-center gap-2">
          <Clock className="size-4" />
          Horarios de Reunión
        </h4>
        <ul class="space-y-1 text-xs sm:text-sm text-white/80 font-body">
          <li class="py-2.5 border-b border-white/10">
            <span class="block font-semibold text-white">Domingos de Celebración:</span>
            <span class="text-white/75">10:00 a.m. y 7:30 p.m.</span>
          </li>
          <li class="py-2.5 border-b border-white/10">
            <span class="block font-semibold text-white">Martes de Oración:</span>
            <span class="text-white/75">7:30 p.m.</span>
          </li>
          <li class="py-2.5">
            <span class="block font-semibold text-white">Jueves de Discipulado:</span>
            <span class="text-white/75">7:30 p.m.</span>
          </li>
        </ul>
      </div>

      {/* Columna 3: Contacto y Ubicación */}
      <div class="space-y-3">
        <h4 class="font-heading font-bold text-sm uppercase tracking-wider text-[#BA9A7D] flex items-center gap-2">
          <MapPin className="size-4" />
          Contacto y Visita
        </h4>
        <div class="space-y-2.5 text-xs sm:text-sm text-white/80 font-body">
          <p class="flex items-start gap-2">
            <MapPin className="size-4 text-[#BA9A7D] shrink-0 mt-0.5" />
            <a
              href="https://maps.app.goo.gl/g9BV6bRdonNRzcqf7"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors underline-offset-4 hover:underline"
            >
              Parque Ricardo Palma 144, Bellavista, Callao
            </a>
          </p>

          <p class="flex items-center gap-2">
            <Phone className="size-4 text-[#BA9A7D] shrink-0" />
            <a href="tel:+51914258692" class="hover:text-white transition-colors">
              +51 914 258 692
            </a>
          </p>

          <p class="flex items-center gap-2">
            <Mail className="size-4 text-[#BA9A7D] shrink-0" />
            <a href="mailto:contacto@iglesiajcv.com" class="hover:text-white transition-colors">
              contacto@iglesiajcv.com
            </a>
          </p>
        </div>
      </div>

      {/* Columna 4: Navegación Rápida */}
      <div class="space-y-3">
        <h4 class="font-heading font-bold text-sm uppercase tracking-wider text-[#BA9A7D]">
          Explorar
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-white/80 font-body">
          <li>
            <a href="/conocenos" class="hover:text-white transition-colors">
              Sobre Nosotros (Conócenos)
            </a>
          </li>
          <li>
            <a href="/#ministerios" class="hover:text-white transition-colors">
              Ministerios (Varones, Damas, Jóvenes)
            </a>
          </li>
          <li>
            <a href="/#ubicacion" class="hover:text-white transition-colors">
              Cómo Llegar y Referencias
            </a>
          </li>
          <li>
            <a href="/#versiculo" class="hover:text-white transition-colors">
              Versículo del Día
            </a>
          </li>
          <li>
            <a href="/#donar" class="hover:text-white transition-colors">
              Generosidad y Ofrendas
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Barra Final de Crédito y Copyright */}
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60">
      <p>© {new Date().getFullYear()} Iglesia Jesús Camino de Vida. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1.5 text-white/50">
        Desarrollado por Arturo Santiago
      </p>
    </div>
  </div>
</footer>
