---
import MapComponent from "@/components/ui/MapSection";
import { Bus, MapPin, Clock, Car } from "lucide-react";
---

<section id="ubicacion" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    {/* Columna Izquierda: Información de Visita y Rutas */}
    <div class="lg:col-span-5 flex flex-col justify-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#7D5836]/15 text-[#5A3C1E] text-xs font-bold uppercase tracking-wider w-fit mb-3">
        <MapPin className="size-3.5" />
        Ubicación y Rutas
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-foreground leading-[1.1] tracking-tight">
        Estamos cerca de ti en el Callao
      </h2>

      <p class="mt-3 text-base sm:text-lg text-foreground/80 leading-relaxed font-body">
        Ubicados a pasos de la Av. Óscar R. Benavides (Colonial) y Av. Faucett. Planifica tu llegada fácil y cómodamente para nuestros servicios.
      </p>

      {/* Tarjetas de Guía de Acceso */}
      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/80 border border-black/5 shadow-xs">
          <div class="size-9 rounded-lg bg-[#7D5836]/15 text-[#7D5836] flex items-center justify-center shrink-0 mt-0.5">
            <Bus className="size-4.5" />
          </div>
          <div>
            <h3 class="font-heading font-semibold text-sm text-foreground">En Transporte Público</h3>
            <p class="text-xs sm:text-sm text-foreground/75 leading-relaxed mt-0.5">
              Bájate en el <strong>Paradero San José</strong> (Av. Colonial). Camina 2 cuadras hacia el Parque Ricardo Palma.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/80 border border-black/5 shadow-xs">
          <div class="size-9 rounded-lg bg-[#7D5836]/15 text-[#7D5836] flex items-center justify-center shrink-0 mt-0.5">
            <Car className="size-4.5" />
          </div>
          <div>
            <h3 class="font-heading font-semibold text-sm text-foreground">Punto de Referencia</h3>
            <p class="text-xs sm:text-sm text-foreground/75 leading-relaxed mt-0.5">
              A 3 minutos de <strong>Plaza Vea Colonial</strong>. Zona residencial tranquila con estacionamiento en los alrededores del parque.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3 p-4 rounded-xl bg-white/80 border border-black/5 shadow-xs">
          <div class="size-9 rounded-lg bg-[#7D5836]/15 text-[#7D5836] flex items-center justify-center shrink-0 mt-0.5">
            <Clock className="size-4.5" />
          </div>
          <div>
            <h3 class="font-heading font-semibold text-sm text-foreground">Horarios de Reunión</h3>
            <p class="text-xs sm:text-sm text-foreground/75 leading-relaxed mt-0.5">
              Domingos a las <strong>10:00 a.m.</strong> y <strong>7:30 p.m.</strong> · Martes y Jueves <strong>7:30 p.m.</strong>
            </p>
          </div>
        </div>
      </div>
    </div>

    {/* Columna Derecha: Mapa Interactivo */}
    <div class="lg:col-span-7 w-full">
      <MapComponent client:idle />
    </div>
  </div>
</section>
