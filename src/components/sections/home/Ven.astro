---
import { ArrowRight, Clock, MapPin, Heart } from "lucide-react";
---

<section id="conocenos" class="bg-background py-14 sm:py-20 lg:py-24 overflow-hidden"> 
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- Imagen con proporción balanceada -->
      <div class="lg:col-span-5 relative">
        <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-black/5 aspect-[4/5] max-w-md mx-auto lg:max-w-none">
          <img
            src="/images/Church.png"
            alt="Comunidad en Iglesia Jesús Camino de Vida en Callao"
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.02]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white">

            <p class="font-heading font-bold text-lg leading-snug">
              Un lugar donde cada vida es acogida con amor
            </p>
          </div>
        </div>
      </div>

      <!-- Contenido -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7D5836]/15 text-[#5A3C1E] text-xs font-bold uppercase tracking-wider w-fit mb-3">
          Sobre Nosotros
        </div>

        <h2
          id="ven-y-conoce-title"
          class="font-heading text-3xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight text-foreground"
        >
          Ven y Conoce
        </h2>

        <p class="mt-4 text-base sm:text-lg lg:text-xl text-foreground/85 leading-relaxed font-body">
          Soñamos con un movimiento que no se queda, sino que va; que cruza fronteras y corazones para compartir el evangelio de Jesús. Un espacio donde cada paso es una oportunidad para anunciar Su amor, y cada vida transformada se convierte en un testimonio vivo del poder de Dios.
        </p>

        <!-- Bloque de Horarios y Dirección con diseño semántico -->
        <div class="mt-6 sm:mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div class="flex items-start gap-3 p-4 rounded-2xl bg-white/80 border border-black/5 shadow-xs">
            <div class="size-9 rounded-xl bg-[#7D5836]/15 text-[#7D5836] flex items-center justify-center shrink-0 mt-0.5">
              <Clock className="size-4.5" />
            </div>
            <div>
              <p class="font-heading font-bold text-sm text-foreground">Horarios de Reunión</p>
              <p class="text-xs text-foreground/80 mt-0.5"><strong>Martes y Jueves:</strong> 7:30 p.m.</p>
              <p class="text-xs text-foreground/80"><strong>Domingos:</strong> 10:00 a.m. & 7:30 p.m.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-2xl bg-white/80 border border-black/5 shadow-xs">
            <div class="size-9 rounded-xl bg-[#7D5836]/15 text-[#7D5836] flex items-center justify-center shrink-0 mt-0.5">
              <MapPin className="size-4.5" />
            </div>
            <div>
              <p class="font-heading font-bold text-sm text-foreground">Punto de Encuentro</p>
              <p class="text-xs text-foreground/80 mt-0.5">Parque Ricardo Palma 144</p>
              <p class="text-xs text-foreground/80">Bellavista, Callao</p>
            </div>
          </div>
        </div>

        <!-- Botones con interacción limpia (sin layout shifts) -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#ubicacion"
            class="inline-flex h-12 items-center justify-center rounded-xl bg-[#7D5836] px-7 text-sm sm:text-base font-bold text-white shadow-md transition-all duration-200 hover:bg-[#69492C] active:scale-95"
          >
            ¿Primera vez? Planifica tu visita
          </a>

          <a
            href="#ministerios"
            class="group inline-flex h-12 items-center gap-2 rounded-xl bg-white/90 hover:bg-white px-6 text-sm sm:text-base font-semibold text-foreground border border-black/10 transition-all duration-200 shadow-xs active:scale-95"
          >
            Conoce nuestros ministerios
            <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
