---
import { MessageCircleHeart, Send } from "lucide-react";
import { Button } from "@/components/ui/button";
---

<section id="oremos" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
  <div
    class="relative min-h-[340px] sm:min-h-[380px] rounded-3xl overflow-hidden flex flex-col justify-center items-center p-8 sm:p-12 md:p-16 text-center shadow-2xl border border-black/10 bg-cover bg-center"
    style="background-image: linear-gradient(to top, rgba(18,18,19,0.92) 0%, rgba(18,18,19,0.65) 60%, rgba(18,18,19,0.85) 100%), url('/images/Testing.webp')"
  >
    <div class="relative z-10 flex flex-col items-center gap-4 max-w-2xl mx-auto text-white">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider">
        <MessageCircleHeart className="size-3.5 fill-rose-300 stroke-rose-300" />
        Acompañamiento Espiritual
      </div>

      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
        ¿Hay algo en tu corazón?
      </h2>

      <p class="text-sm sm:text-base md:text-lg text-white/90 font-body leading-relaxed max-w-xl">
        No tienes que llevar tus cargas solo. Nuestro equipo pastoral y de intercesión ora por ti y tu familia en cada reunión.
      </p>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-3.5">
        <Button
          size="lg"
          asChild
          className="bg-[#7D5836] hover:bg-[#69492C] text-white font-bold px-8 h-12 text-sm sm:text-base rounded-xl shadow-lg transition-transform hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
        >
          <a
            href="https://wa.me/51914258692?text=Hola%20Jes%C3%BAs%20Camino%20de%20Vida,%20quisiera%20compartir%20un%20motivo%20de%20oraci%C3%B3n"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2"
          >
            <Send className="size-4" />
            Enviar petición de oración
          </a>
        </Button>
      </div>
    </div>
  </div>
</section>
