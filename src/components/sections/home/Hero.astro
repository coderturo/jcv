---
import CTA from "@/components/ui/CTA";
import Header from "@/components/ui/Header";
import { Clock, MapPin } from "lucide-react";
const bgImage = "/images/Callao.png";
---

<section id="top" class="p-2 sm:p-4 md:pt-6 md:px-6 relative">
  <div
    class="relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl ring-1 ring-black/10
           min-h-[88vh] md:min-h-[92vh] flex flex-col justify-between bg-cover bg-center md:bg-top"
    style={`background-image: url('${bgImage}')`}
  >
    <!-- Overlay con degradado para legibilidad garantizada -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80 z-0"></div>

    <Header client:load theme="dark" currentPath="/" />

    <!-- Contenido Central del Hero -->
    <div class="relative z-10 flex flex-1 items-center justify-center text-center px-4 sm:px-6 pt-28 pb-16 sm:pt-32 sm:pb-20 md:pt-36 md:pb-24">
      <div class="max-w-4xl mx-auto">
        <p class="font-accent text-[#E6D3C2] text-xl sm:text-2xl md:text-3xl font-medium tracking-wide">
          Bienvenido a Jesús Camino de Vida
        </p>

        <h1 class="mt-4 font-heading font-bold text-white text-4xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.08] tracking-tight">
          Fe que transforma,<br class="hidden sm:inline" />
          amor que permanece
        </h1>

        <p class="mt-5 text-white/85 text-base sm:text-lg md:text-xl max-w-2xl mx-auto font-body leading-relaxed">
          Una comunidad viva en el Callao para crecer espiritualmente, servir en familia y conocer más de Jesús.
        </p>

        <!-- Acciones Principales -->
        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-5">
          <CTA href="#conocenos">
            Ven y Conoce
          </CTA>

          <a
            href="#ubicacion"
            class="inline-flex items-center justify-center gap-2 px-6 h-13 rounded-xl bg-white/15 hover:bg-white/25 backdrop-blur-md text-white text-base md:text-lg font-semibold border border-white/25 transition-all duration-200 active:scale-95"
          >
            <MapPin className="size-5 text-[#BA9A7D]" />
            Ver ubicación y horarios
          </a>
        </div>
      </div>
    </div>

    <!-- Barra Inferior de Datos Clave (1 pantalla con datos duros: regla copy-fact) -->
    <div class="relative z-10 border-t border-white/15 bg-black/30 backdrop-blur-md px-6 py-4">
      <div class="mx-auto max-w-6xl flex flex-wrap items-center justify-around gap-4 text-white/90 text-xs sm:text-sm">
        <div class="flex items-center gap-2">
          <Clock className="size-4 text-[#BA9A7D]" />
          <span><strong>Domingos:</strong> 10:00 a.m. y 7:30 p.m. · <strong>Mar & Jue:</strong> 7:30 p.m.</span>
        </div>
        <div class="flex items-center gap-2">
          <MapPin className="size-4 text-[#BA9A7D]" />
          <span>Parque Ricardo Palma 144, Bellavista, Callao</span>
        </div>
      </div>
    </div>
  </div>
</section>
