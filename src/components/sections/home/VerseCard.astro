---
import { Quote, Share2, Check } from "lucide-react";

interface Props {
  texto: string;
  referencia: string;
}
const { texto, referencia } = Astro.props;
---

<section id="versiculo" class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
  <div
    class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#BA9A7D] via-[#a8886b] to-[#917154] p-8 sm:p-12 md:p-16 text-white shadow-2xl border border-black/10"
  >
    {/* Marca de agua decorativa */}
    <div class="absolute -right-8 -bottom-8 opacity-10 pointer-events-none">
      <svg
        width="280"
        height="280"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
      >
        <rect x="42" y="5" width="16" height="90"></rect>
        <rect x="10" y="28" width="80" height="16"></rect>
      </svg>
    </div>

    <div class="relative z-10 flex flex-col items-center text-center max-w-3xl mx-auto">
      {/* Etiqueta superior */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-bold uppercase tracking-[0.18em] mb-6">
        <Quote className="size-3.5 fill-white" />
        Palabra de Esperanza
      </div>

      {/* Cita del Versículo */}
      <blockquote
        id="daily-verse-text"
        class="font-accent font-normal italic text-2xl sm:text-3xl md:text-4xl leading-[1.35] text-white/95"
      >
        “{texto}”
      </blockquote>

      <div class="my-6 h-0.5 w-16 bg-white/40 rounded-full"></div>

      {/* Referencia bíblica */}
      <p
        id="daily-verse-ref"
        data-referencia
        class="font-heading font-bold text-lg sm:text-xl text-[#F5EBE1] tracking-wide"
      >
        {referencia}
      </p>

      {/* Botón interactivo para copiar/compartir */}
      <button
        id="share-verse-btn"
        type="button"
        class="mt-8 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/15 hover:bg-white/25 backdrop-blur-md text-xs sm:text-sm font-semibold text-white transition-all duration-200 cursor-pointer border border-white/20 active:scale-95"
        data-texto={texto}
        data-referencia={referencia}
      >
        <Share2 className="size-3.5" />
        <span id="share-btn-label">Compartir versículo</span>
      </button>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("share-verse-btn");
  const label = document.getElementById("share-btn-label");

  btn?.addEventListener("click", async () => {
    const textEl = document.getElementById("daily-verse-text");
    const refEl = document.getElementById("daily-verse-ref");
    const fullText = `${textEl?.textContent?.trim()} — ${refEl?.textContent?.trim()}`;

    if (navigator.share) {
      try {
        await navigator.share({
          title: "Versículo del Día - JCV",
          text: fullText,
          url: window.location.href,
        });
        return;
      } catch {
        // Fallback a clipboard si se cancela o falla
      }
    }

    try {
      await navigator.clipboard.writeText(fullText);
      if (label) {
        const prev = label.textContent;
        label.textContent = "¡Copiado al portapapeles!";
        setTimeout(() => {
          label.textContent = prev;
        }, 2200);
      }
    } catch {
      // Ignorar fallo de portapapeles
    }
  });
</script>
