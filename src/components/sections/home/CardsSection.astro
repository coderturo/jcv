---
import { Users, ArrowRight } from "lucide-react";

interface Ministerio {
  id: string;
  nombre: string;
  subtitulo: string;
  descripcion: string;
  horario: string;
  imagen: string;
  href: string;
}

const MINISTERIOS: Ministerio[] = [
  {
    id: "varones",
    nombre: "Ministerio de Varones",
    subtitulo: "Hombres de Fe",
    descripcion:
      "Dios te llama a ser líder en tu hogar y comunidad. Ven y fortalece tu fe en nuestra reunión de hombres.",
    horario: "Sábados · 4:00 p.m.",
    imagen: "/images/MVarones.jpg",
    href: "/visitanos#varones",
  },
  {
    id: "damas",
    nombre: "Ministerio de Damas",
    subtitulo: "Mujeres con Propósito",
    descripcion:
      "¿Necesitas un respiro y un tiempo con Dios? Únete a nuestro ministerio de damas. Vamos a orar, aprender y crecer juntas.",
    horario: "Viernes · 7:30 p.m.",
    imagen: "/images/MDamas.jpg",
    href: "/visitanos#damas",
  },
  {
    id: "jovenes",
    nombre: "Ministerio de Jóvenes",
    subtitulo: "Generación Radical",
    descripcion:
      "¡No lo veas por historias, vívelo tú mismo! Invitados todos los jóvenes a un tiempo de conexión real. ¡Trae a un amigo!",
    horario: "Sábados · 7:30 p.m.",
    imagen: "/images/MJovenes.jpeg",
    href: "/visitanos#jovenes",
  },
];
---

<section id="ministerios" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#7D5836]/15 text-[#5A3C1E] text-xs font-bold uppercase tracking-wider mb-3">
      <Users className="size-3.5" />
      Comunidad y Grupos
    </div>

    <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-foreground leading-tight tracking-tight">
      Un lugar para cada etapa de tu vida
    </h2>

    <p class="mt-3.5 text-base sm:text-lg text-foreground/80 leading-relaxed font-body">
      Cada una de nuestras reuniones es el escenario perfecto para fortalecer tu vínculo con Jesús. No estás solo: camina junto a una familia que te acompaña.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
    {
      MINISTERIOS.map((item) => (
        <article class="group relative flex flex-col justify-end min-h-[380px] sm:min-h-[440px] rounded-3xl overflow-hidden border border-black/10 shadow-lg bg-[#121213] transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
          {/* Imagen de Fondo */}
          <img
            src={item.imagen}
            alt={item.nombre}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 opacity-85"
            loading="lazy"
          />

          {/* Gradiente oscuro para asegurar contraste según WCAG 4.5:1 */}
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/55 to-black/20 group-hover:from-black/90 transition-colors" />

          {/* Contenido */}
          <div class="relative z-10 p-6 sm:p-7 flex flex-col justify-end text-white">
            <span class="text-xs font-bold uppercase tracking-wider text-[#E6D3C2] mb-1">
              {item.subtitulo}
            </span>

            <h3 class="font-heading text-xl sm:text-2xl font-bold text-white leading-snug">
              {item.nombre}
            </h3>

            {/* Descripción siempre visible en móvil y desktop */}
            <p class="mt-2 text-xs sm:text-sm text-white/85 leading-relaxed font-body">
              {item.descripcion}
            </p>

            <div class="mt-4 pt-3.5 border-t border-white/20 flex items-center justify-between">
              <span class="text-xs font-medium text-white/80">
                {item.horario}
              </span>

              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E6D3C2] hover:text-white transition-colors group-hover:translate-x-1 duration-200"
              >
                Conocer más
                <ArrowRight className="size-3.5" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
